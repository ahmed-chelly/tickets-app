# Copy this file to .env for local development. Never commit a filled-in .env.
#
# These variables only NAME the Databricks secret holding the Lakebase
# connection URL - they are not the URL itself. app.py/lakebase.py fetch the
# actual connection string at runtime through the Databricks SDK, so no
# password or connection string ever belongs in this file.
#
# On Databricks Apps these same values come from app.yaml, so you do not need
# a .env there.

LAKEBASE_SECRET_SCOPE=tickets-app-database
LAKEBASE_SECRET_KEY=lakebase-url
